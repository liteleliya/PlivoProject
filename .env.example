# Plivo credentials (provided in the assignment PDF)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# Plivo number the call is placed FROM
PLIVO_FROM_NUMBER=+918035454161

# "Live associate" number the caller is forwarded to on Level 2 -> Press 2
ASSOCIATE_NUMBER=+912264236412

# 4-digit OTP: birthdate in DDMM format
OTP_CODE=

# Default destination; can be overridden per-call from the UI
TARGET_NUMBER=

# Public HTTPS base URL of this app (cloudflared tunnel or Vercel).
# Leave blank to auto-derive from the incoming request host.
PUBLIC_BASE_URL=

# Secret used to sign the post-OTP session token
SESSION_SECRET=

# Publicly accessible MP3 played on Level 2 -> Press 1
AUDIO_URL=https://s3.amazonaws.com/plivocloud/music.mp3
